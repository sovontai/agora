{
  "name": "@sovont/agora-mcp",
  "version": "0.3.0",
  "description": "MCP server for the Agora agent registry — discover AI agents from inside Claude, Cursor, Zed, and any MCP client.",
  "type": "module",
  "bin": {
    "agora-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
