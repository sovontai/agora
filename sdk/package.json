{
  "name": "@sovont/agora",
  "version": "0.3.0",
  "description": "TypeScript SDK + CLI for the Agora agent registry — discover and register AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agora": "dist/cli.js"
  },
